source "https://rubygems.org"

# Pin to Jekyll 4, which is what GitHub Pages currently builds against.
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-archives"
end

# Windows and JRuby do not include zoneinfo files; the tzinfo-data gem
# supplies them for those platforms. Safe on all platforms.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
